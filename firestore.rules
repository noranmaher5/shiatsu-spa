rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only a signed-in user whose ID token carries the custom
    // `role: "admin"` claim (set via the Admin SDK, never client-side)
    // may write. This claim is the single source of truth for admin
    // access — there is no other privilege check anywhere in the rules.
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Public, read-only content collections. Anyone (including
    // unauthenticated visitors) can read; only admins can write.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faq/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin user records: only readable/writable by an authenticated
    // admin, and only their own record (no listing other admins'
    // documents client-side).
    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false; // only ever written by the Admin SDK
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
