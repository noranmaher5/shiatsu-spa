# ==============================================================================
# SHIATSU SPA KUWAIT — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials.
# ==============================================================================

# ---- Firebase CLIENT config (safe to expose to the browser) ----
# Firebase Console → Project Settings → General → "Your apps" → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase ADMIN SDK config (SERVER-ONLY — never prefix with NEXT_PUBLIC_) ----
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the values from the downloaded JSON file. FIREBASE_ADMIN_PRIVATE_KEY must
# keep its literal "\n" characters (do not manually convert them to real newlines
# in this file — lib/firebase/admin.ts converts them at runtime).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- ISR / on-demand revalidation ----
# A random secret you generate yourself (e.g. `openssl rand -hex 32`). The admin
# dashboard's save handlers send this in a header when calling /api/revalidate,
# and the route rejects any request that doesn't include it.
REVALIDATE_SECRET=

# ---- Analytics / tracking (all optional — leave blank if the client doesn't have these yet) ----
# Populated later via the admin dashboard's Website Settings module, but also
# readable from env as a fallback/default for initial deployment.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Google Maps Embed API (optional but recommended) ----
# Google Cloud Console → enable "Maps Embed API" → create an API key.
# Free tier comfortably covers a two-branch business site. Without this,
# branch map embeds fall back to an undocumented (but currently working)
# URL-based embed technique — see features/branches/lib/google-maps.ts.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# ---- Site URL (used for absolute URLs in SEO metadata, sitemaps, OG tags) ----
NEXT_PUBLIC_SITE_URL=https://shiatsuspakw.com

# ---- Cloudinary image uploads (server-only) ----
# Cloudinary Console -> Product Environment -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
